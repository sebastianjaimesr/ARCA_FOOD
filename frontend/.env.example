# Copia este archivo como frontend/.env.local y completa los valores.
# Todo lo que empieza por VITE_ queda visible en el navegador: no pongas secretos aquí.

# URL del backend en producción. En desarrollo déjala vacía: Vite reenvía /api a localhost:4000.
VITE_API_URL=

# Supabase Auth (solo para el inicio de sesión del panel).
# La clave anon/publishable es pública por diseño; NUNCA pongas aquí la service_role.
# Con Supabase local: `npx supabase status` → API_URL y ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
