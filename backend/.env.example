# Copia este archivo como backend/.env y completa los valores.
# NUNCA subas el archivo .env al repositorio.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Proxies delante del servidor. 0 en local; 1 detrás del proxy del hosting
# (Render, Railway, Fly…). Un valor mayor al real permite falsear la IP.
TRUST_PROXY=0

# Orígenes que pueden llamar a la API, separados por comas.
# En producción: solo el dominio real del frontend (https://...).
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Fase 3) ---
# Con Supabase local, `npx supabase status` muestra estos valores.
DATABASE_URL=
SUPABASE_URL=
# Clave service_role: SOLO en el backend. Jamás en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=
