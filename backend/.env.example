# Copia este archivo como backend/.env y completa los valores.
# En el hosting, configura estas mismas variables en su panel (no subas .env).
# NUNCA subas el archivo .env al repositorio.

# development | production
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Proxies delante del servidor. 0 en local; 1 detrás del proxy del hosting
# (Render, Railway, Fly…). Un valor mayor al real permite falsear la IP.
TRUST_PROXY=0

# Orígenes que pueden llamar a la API, separados por comas.
# En producción: solo el dominio real del frontend, con https:// (obligatorio).
CORS_ORIGINS=http://localhost:5173

# --- Base de datos y Supabase ---
# Local: `npx supabase status` muestra DB_URL, API_URL y SERVICE_ROLE_KEY.
# Producción: Supabase → Project Settings → Database → Connection string →
#   "Session pooler" (funciona con IPv4). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=
SUPABASE_URL=
# Clave service_role: SOLO en el backend. Jamás en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado hacia PostgreSQL: disable (solo local) | require | verify-full (recomendado).
DATABASE_SSL=disable
# Con verify-full: certificado de Supabase (Project Settings → Database → SSL
# Configuration → Download certificate). Pégalo en una línea con \n.
DATABASE_CA_CERT=

# --- Solo desarrollo local ---
# Clave anon para que las pruebas de integración inicien sesión.
SUPABASE_ANON_KEY=
# Cuenta admin que recrea `npm run db:reset` (solo funciona contra Supabase local).
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
